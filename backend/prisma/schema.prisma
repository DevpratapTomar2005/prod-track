generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id                  String               @id @default(uuid())
  firstname           String
  lastname            String
  email               String               @unique
  password            String
  sessions            Sessions[]
  isValid             Boolean              @default(false)
  otps                Otps[]
  passwordResetTokens PasswordResetToken[]
  projects            Project[]
  tasks               Task[]
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  @@map("users")
}

model Sessions {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  userAgent    String
  refreshToken String
  revoked      Boolean  @default(false)
  ip           String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("sessions")
}

model Otps {
  id         Int      @id @default(autoincrement())
  email      String
  otp        String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("otps")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model Project {
  id         String   @id @default(uuid())
  name       String
  start_date DateTime
  end_date   DateTime
  status     Status   @default(TODO)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tasks      Task[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("projects")
}

model Task {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  task         String
  estStartTime DateTime
  estStartDate DateTime
  dueDate      DateTime
  status       Status    @default(TODO)
  subtasks     Subtask[]
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String?
  duration     Decimal
  unit         String
  elapsedTime  DateTime?
  overRun      DateTime?
  orgStartDate DateTime?
  orgEndDate   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("tasks")
}

model Subtask {
  id         Int      @id @default(autoincrement())
  subtask    String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("subtasks")
}
